# ==============================================================================
# VÉRONA High-End Garments E-Commerce Platform
# Environment Configuration Specification (Phase 30 — Production Readiness)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.local for local development.
# 2. In staging/production, configure these variables directly in your deployment
#    platform (e.g., Vercel, AWS ECS, Kubernetes Secrets).
# 3. NEVER commit real production secrets, keys, or passwords to git.
# 4. Client-accessible variables MUST be explicitly prefixed with NEXT_PUBLIC_.
# 5. Server-only variables MUST NOT have NEXT_PUBLIC_ to prevent browser leaks.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
# Runtime environment: development | staging | production
NODE_ENV=production

# Server port (default 3000)
PORT=3000

# Canonical public application URL (used for SEO canonicals, sitemap, OAuth redirects)
# Development: http://localhost:3000
# Production: https://verona.fashion
NEXT_PUBLIC_APP_URL=https://verona.fashion

# ------------------------------------------------------------------------------
# 2. PERSISTENCE & DATABASE (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Production connection URI with TLS, replica set, and authSource.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://verona_app:<REPLACE_WITH_STRONG_PASSWORD>@cluster0.mongodb.net/verona_production?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. IDENTITY & AUTHENTICATION (Clerk)
# ------------------------------------------------------------------------------
# Public publishable key exposed to the browser for client SDK initialization
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Secret API key strictly restricted to server-side authentication validation
CLERK_SECRET_KEY=sk_test_...

# Standard routing paths for authentication flows
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/account
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/account

# Optional Clerk Webhook Signing Secret for user lifecycle event synchronization
CLERK_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 4. PAYMENTS & GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# Client-side public key ID for opening the Razorpay Checkout Modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...

# Server-side key ID used for orders API communication
RAZORPAY_KEY_ID=rzp_live_...

# Server-side key secret used for payment signature verification
RAZORPAY_KEY_SECRET=<REPLACE_WITH_LIVE_RAZORPAY_SECRET>

# Webhook signature secret used for HMAC SHA-256 verification of payment events
RAZORPAY_WEBHOOK_SECRET=<REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET>

# ------------------------------------------------------------------------------
# 5. MEDIA STORAGE & OPTIMIZATION (Cloudinary)
# ------------------------------------------------------------------------------
# Cloudinary account name used for image transformations and responsive deliveries
CLOUDINARY_CLOUD_NAME=verona-fashion

# Server-side API key for signed upload presets and asset deletions
CLOUDINARY_API_KEY=...

# Server-side API secret for administrative asset signatures
CLOUDINARY_API_SECRET=<REPLACE_WITH_CLOUDINARY_SECRET>

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL & NOTIFICATIONS (Resend)
# ------------------------------------------------------------------------------
# Resend API Key for dispatching order confirmations, shipping updates, receipts
RESEND_API_KEY=re_...

# Canonical transactional sender address with authenticated domain (SPF/DKIM/DMARC)
EMAIL_FROM=VÉRONA Atelier <concierge@verona.fashion>

# Inbound reply-to address directed to client customer concierge team
EMAIL_REPLY_TO=concierge@verona.fashion

# Webhook signature secret for verifying delivery status callbacks
RESEND_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 7. FULFILLMENT & SHIPPING LOGISTICS
# ------------------------------------------------------------------------------
# Active carrier adapter: MANUAL | SHIPROCKET | BLUEDART | DELHI VERY
SHIPPING_PROVIDER=MANUAL

# Carrier logistics API key
SHIPPING_API_KEY=...

# Carrier logistics API secret
SHIPPING_API_SECRET=<REPLACE_WITH_SHIPPING_SECRET>

# Carrier tracking webhook verification secret
SHIPPING_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 8. OBSERVABILITY, LOGGING & SECURITY
# ------------------------------------------------------------------------------
# Logging threshold: debug | info | warn | error
LOG_LEVEL=info

# Secret key required to trigger background cleanup jobs (e.g., reservation expiry)
CRON_SECRET=<REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_UUID>

# Allowed CORS origins for external webhook and API integrations (comma-separated)
ALLOWED_ORIGINS=https://verona.fashion,https://admin.verona.fashion
